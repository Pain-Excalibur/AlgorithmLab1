<Window x:Class="AlgorithmLab1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlgorithmLab1"
        xmlns:oxy="http://oxyplot.org/wpf"
        mc:Ignorable="d"
        Title="Алгоритмы | Лабораторная №1" Height="720" Width="1280" FontSize="18" ResizeMode="CanMinimize">
    <Grid Margin="10,5,10,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <GroupBox Header="График" Grid.RowSpan="5" BorderThickness="3" BorderBrush="Gray">
            <oxy:PlotView x:Name="AlgGraph"/>
        </GroupBox>

        <GroupBox Header="Выбор алгоритма" Grid.Column="1" Grid.RowSpan="2" Padding="10" BorderThickness="3" BorderBrush="Gray">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.20*"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <ComboBox x:Name="AlgSelector" Grid.Row="0"  VerticalContentAlignment="Center" SelectionChanged="AlgSelector_SelectionChanged"/>

                <TextBlock Grid.Row="1" Padding="10" TextWrapping="Wrap">
                    Выберите алгоритм из выпадающего списка и нажмите <Bold>"Запустить алгоритм"</Bold>, чтобы начать эксперимент. 
                    Убедитесь, что параметры снизу введены правильно.
                </TextBlock>
            </Grid>
        </GroupBox>

        <GroupBox Header="Установка параметров" Grid.Column="1" Grid.Row="2" Grid.RowSpan="2" Padding="10" BorderThickness="3" BorderBrush="Gray">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition Height="5*"/>
                </Grid.RowDefinitions>

                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                    Введите n:
                </TextBlock>
                <TextBox x:Name="InputBoxN" Grid.Row="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,5,0"/>

                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    Введите m:
                </TextBlock>
                <TextBox x:Name="InputBoxM" Grid.Column="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="1" Margin="5,0,0,0"/>

                <TextBlock Grid.Row="2" Grid.RowSpan="2" Grid.ColumnSpan="2" TextWrapping="Wrap" Padding="10">
                    <Bold>n</Bold> – длина массива / размер матриц / степень.
                    <LineBreak/>
                    <Bold>m</Bold> – количество итераций для подсчёта среднего значения.
                    <LineBreak/>
                    <Bold>Вводите положительные целые числа.</Bold>
                </TextBlock>
            </Grid>
        </GroupBox>

        <GroupBox Header="Начать эксперимент" Grid.Column="1" Grid.Row="5" Padding="10" BorderThickness="3" BorderBrush="Gray">
            <!--Здесь будет происходить запуск алгоритмов-->
            <Button x:Name="RunButton" Content="Запустить алгоритм" Click="RunButton_Click"/>
        </GroupBox>
    </Grid>
</Window>
